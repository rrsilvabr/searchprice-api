{
  "name": "searchprice-api",
  "version": "1.0.0",
  "description": "SearchPrice API",
  "main": "index.js",
  "scripts": {
    "start": "node ./build/index.js",
    "development": "ts-node-dev ./src/index.ts",
    "build": "tsc",
    "knex:rollback-all": "knex --knexfile ./src/server/database/knex/Enviroment.ts migrate:rollback --all",
    "knex:rollback": "knex --knexfile ./src/server/database/knex/Enviroment.ts migrate:rollback",
    "knex:migrate": "knex --knexfile ./src/server/database/knex/Enviroment.ts migrate:latest",
    "knex:seed": "knex --knexfile ./src/server/database/knex/Enviroment.ts seed:run",
    "test": "jest"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-status-codes": "^2.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^28.1.8",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/mysql": "^2.15.26",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^5.30.6",
    "@typescript-eslint/parser": "^5.30.6",
    "jest": "^28.1.3",
    "supertest": "^6.3.4",
    "ts-jest": "^28.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.7.4"
  }
}
